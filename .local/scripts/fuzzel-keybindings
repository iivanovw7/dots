#!/usr/bin/env bash

config="$HOME/.config/hypr/hyprland.lua"
index="$HOME/.config/hypr/keybindings.tsv"

# Reload the index if it does not exist.
if [[ ! -f "$index" ]]; then
    hyprctl reload
fi

[[ -f "$index" ]] || exit 1

declare -a labels=()
declare -a commands=()

while IFS=$'\t' read -r label command; do
    [[ -n "$label" ]] || continue
    labels+=("$label")
    commands+=("$command")
done <"$index"

((${#labels[@]})) || exit 0

selected=$(
    printf '%s\n' "${labels[@]}" |
        fuzzel --dmenu \
            --index \
            --prompt="󰌌 Keybindings: " \
            --width=100 \
            --lines=20
)

[[ "$selected" =~ ^[0-9]+$ ]] || exit 0
(("$selected" < ${#commands[@]})) || exit 0

command="${commands[$selected]}"

if [[ -n "$command" ]]; then
    bash -lc "$command"
fi
